{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":automergeAll",
    ":automergeRequireAllStatusChecks",
    "schedule:nonOfficeHours",
    ":disableDependencyDashboard"
  ],
  "timezone": "America/Los_Angeles",
  "packageRules": [
    {
      "description": "prettyplease's `unparse` takes a `syn::File`, so the two crates must be upgraded together.",
      "matchPackageNames": [
        "syn",
        "prettyplease"
      ],
      "groupName": "syn and prettyplease"
    }
  ]
}
